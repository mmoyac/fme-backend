# Variables de entorno para el Backend FME

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://fme:fme@localhost:5432/fme_database

# Mercado Pago
MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gemini Vision API (NUEVO - Requerido para OCR avanzado)
