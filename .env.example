GEMINI_API_KEY=AIzaSy...

# JWT Secret
JWT_SECRET_KEY=tu_clave_secreta_muy_segura

# Entorno
ENVIRONMENT=development

# CORS Origins (opcional)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001